# Supabase Postgres connection (use the transaction pooler URL on Vercel)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Secret token set on the Zoho Billing webhook (12 to 50 alphanumeric characters)
ZOHO_BILLING_WEBHOOK_SECRET=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron calls
CRON_SECRET=

# Public address of this app, used to build customer links (no trailing slash)
APP_BASE_URL=https://app.blogsontap.com

# Signs customer links. 32+ random characters. Changing it breaks every link already sent.
LINK_SECRET=

# Customer email: "log" (prints to the server log; copy links from /admin) or "zeptomail"
EMAIL_PROVIDER=log
ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email   (use your region's host if not US)
EMAIL_FROM=hello@blogsontap.com
EMAIL_FROM_NAME=Blogs on Tap
EMAIL_REPLY_TO=
# Where alerts go: articles ready for review, failed jobs and steps
ADMIN_EMAIL=

# Supabase Storage for customer uploads (server only; never expose this key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# OpenAI. Model IDs come from your OpenAI dashboard; set prices in app.ai_model_prices for cost tracking.
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=
OPENAI_MODEL_RESEARCH=
OPENAI_MODEL_STRATEGY=
