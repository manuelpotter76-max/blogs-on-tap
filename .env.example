# Supabase Postgres connection (use the transaction pooler URL on Vercel)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Secret token set on the Zoho Billing webhook (12 to 50 alphanumeric characters)
ZOHO_BILLING_WEBHOOK_SECRET=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron calls
CRON_SECRET=

# Phase 4
OPENAI_API_KEY=
